@model Inscripcion
@{
    ViewData["Title"] = "Nueva inscripción";
}

<h2>Nueva inscripción</h2>
<hr />

<form asp-action="Create" method="post" class="col-md-8">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="EventoId" class="form-label"></label>
        <select asp-for="EventoId" asp-items="(SelectList)ViewBag.Eventos" class="form-select">
            <option value="">-- Seleccione un evento --</option>
        </select>
        <span asp-validation-for="EventoId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AsistenteId" class="form-label"></label>
        <select asp-for="AsistenteId" asp-items="(SelectList)ViewBag.Asistentes" class="form-select">
            <option value="">-- Seleccione un asistente --</option>
        </select>
        <span asp-validation-for="AsistenteId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Inscribir</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
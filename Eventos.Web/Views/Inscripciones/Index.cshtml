@model IEnumerable<InscripcionListadoViewModel>
@{
    ViewData["Title"] = "Inscripciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Inscripciones</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nueva inscripción</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Todavía no hay inscripciones.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Evento</th>
                <th>Fecha del evento</th>
                <th>Asistente</th>
                <th>DNI</th>
                <th>Fecha de inscripción</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Evento</td>
                    <td>@i.FechaEvento.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@i.Asistente</td>
                    <td>@i.Dni</td>
                    <td>@i.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <span class="badge @(i.PuedeCancelar ? "bg-success" : "bg-secondary")">@i.Estado</span>
                    </td>
                    <td>
                        @if (i.PuedeCancelar)
                        {
                            <form asp-action="Cancelar" asp-route-id="@i.Id" method="post"
                                  onsubmit="return confirm('¿Deseas cancelar esta inscripción?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@model EventoListadoViewModel
@{
    ViewData["Title"] = "Detalle del evento";
}

<h2>@Model.Titulo</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Fecha</dt>
    <dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Lugar</dt>
    <dd class="col-sm-9">@Model.Lugar</dd>

    <dt class="col-sm-3">Modalidad</dt>
    <dd class="col-sm-9">@Model.Modalidad</dd>

    <dt class="col-sm-3">Categoría</dt>
    <dd class="col-sm-9">@Model.Categoria</dd>

    <dt class="col-sm-3">Precio</dt>
    <dd class="col-sm-9">@Model.Precio.ToString("C")</dd>

    <dt class="col-sm-3">Aforo</dt>
    <dd class="col-sm-9">@Model.Aforo</dd>

    <dt class="col-sm-3">Inscritos confirmados</dt>
    <dd class="col-sm-9">@Model.Inscritos</dd>

    <dt class="col-sm-3">Cupos disponibles</dt>
    <dd class="col-sm-9">@Model.CuposDisponibles</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>